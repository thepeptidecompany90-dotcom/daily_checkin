# Copy to .env and fill in real values. .env is gitignored — never commit real keys.

# Postgres connection string used by glp1_agent.config.Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glp1

# LLM (required — CLAUDE.md mandates OpenAI)
OPENAI_API_KEY=

# STT
DEEPGRAM_API_KEY=

# TTS
ELEVENLABS_API_KEY=

# Only needed if running with --transport daily
DAILY_API_KEY=

# V1 placeholder: real call dispatch should pass patient_id via call/room metadata instead
# (see plan doc / bot.py NOTE). Must be an existing row in the patients table.
# Must be set here, not just exported in the shell: pipecat.runner.run does its own
# load_dotenv(override=True) at import time, which always wins over shell-level env vars.
GLP1_PATIENT_ID=
